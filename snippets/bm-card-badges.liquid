{%- comment -%}
  part: badges (default) or save.
  Percent and amount come from compare_at_price vs price. Hidden unless phase is live.
{%- endcomment -%}
{%- liquid
  capture bm_phase_raw
    render 'bm-phase'
  endcapture
  assign bm_phase_now = bm_phase_raw | strip
  assign bm_show = false
  if settings.bm_enabled and bm_phase_now == 'live'
    if template.name == 'index' or template.name == 'collection' or template.name == 'product' or template.name == 'search' or template.suffix contains 'black-month'
      assign bm_show = true
    endif
  endif
  assign bm_price = product.price
  assign bm_compare = product.compare_at_price
  if product.price_varies
    assign bm_price = product.price_min
  endif
  assign bm_save = 0
  assign bm_pct = 0
  if bm_compare > bm_price
    assign bm_save = bm_compare | minus: bm_price
    assign bm_pct = bm_save | times: 100.0 | divided_by: bm_compare | round
  endif
  assign bm_part = part | default: 'badges'
-%}
{%- if bm_show -%}
  {%- if bm_part == 'save' -%}
    {%- if bm_save > 0 -%}
      <p class="bm-card-save">{{ settings.bm_save_word }} {{ bm_save | money_without_trailing_zeros }}</p>
    {%- endif -%}
  {%- else -%}
    <div class="bm-card-badges">
      {%- if settings.bm_show_percent_on_singles and bm_pct > 0 -%}
        <span class="bm-badge bm-badge--save">{{ settings.bm_save_word }} {{ bm_pct }} %</span>
      {%- else -%}
        <span></span>
      {%- endif -%}
      <span class="bm-badge bm-badge--campaign">{{ settings.bm_badge_campaign }}</span>
    </div>
  {%- endif -%}
{%- endif -%}
