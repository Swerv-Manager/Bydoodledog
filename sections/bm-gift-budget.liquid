{%- capture bm_phase_raw -%}{%- render 'bm-phase' -%}{%- endcapture -%}
{%- assign bm_phase_now = bm_phase_raw | strip -%}
{%- if bm_phase_now != 'off' -%}
  <section class="bm-section bm-gifts{% if bm_phase_now == 'post' %} bm-gifts--post{% endif %}" id="bm-budget">
    <div class="bm-section__intro">
      <p class="bm-eyebrow">{{ settings.bm_gift_eyebrow }}</p>
      <h2 class="bm-h2">{{ settings.bm_gift_title }}</h2>
    </div>
    <div class="bm-gifts__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign bm_handle = ''
          case forloop.index
            when 1
              assign bm_handle = settings.bm_handle_gift_1
            when 2
              assign bm_handle = settings.bm_handle_gift_2
            when 3
              assign bm_handle = settings.bm_handle_gift_3
          endcase
          if bm_handle == blank
            assign bm_handle = block.settings.handle
          endif
        -%}
        {%- capture bm_href -%}{%- render 'bm-collection-url', handle: bm_handle -%}{%- endcapture -%}
        {%- assign bm_href = bm_href | strip -%}
        {%- if bm_href != blank -%}
        <a class="bm-gift" href="{{ bm_href }}" {{ block.shopify_attributes }}>
          <span class="bm-gift__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag: loading: 'eager', widths: '300, 500, 800', sizes: '(min-width: 990px) 30vw, 100vw', alt: block.settings.title, class: 'bm-gift__img'
              }}
            {%- else -%}
              {%- liquid
                assign bm_gift_asset = ''
                case forloop.index
                  when 1
                    assign bm_gift_asset = 'bm-product-bandana.jpg'
                  when 2
                    assign bm_gift_asset = 'bm-product-bjork-bilsaede-2.jpg'
                  when 3
                    assign bm_gift_asset = 'bm-product-carl-kurv.jpg'
                endcase
              -%}
              {% render 'bm-media', asset: bm_gift_asset, alt: block.settings.title, class: 'bm-gift__img', loading: 'eager', width: 900, height: 1100 %}
              {%- unless bm_gift_asset != blank -%}<span class="bm-media-fallback" aria-hidden="true"></span>{%- endunless -%}
            {%- endif -%}
          </span>
          <span class="bm-gift__kicker">{{ block.settings.kicker }}</span>
          <span class="bm-gift__title">{{ block.settings.title }}</span>
          <span class="bm-gift__text">{{ block.settings.text }}</span>
          <span class="bm-btn bm-btn--ghost">{{ block.settings.button }}</span>
        </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "BM gaver efter budget",
  "blocks": [
    {
      "type": "gift",
      "name": "Budget",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Billede", "info": "Intet produktionsbillede er leveret. Placeholder beholdes, indtil et foto vælges her." },
        { "type": "text", "id": "kicker", "label": "Eyebrow", "default": "Gaver under" },
        { "type": "text", "id": "title", "label": "Beløb", "default": "500 kr." },
        { "type": "text", "id": "text", "label": "Beskrivelse" },
        { "type": "text", "id": "button", "label": "Knap", "default": "Se gaverne" },
        { "type": "text", "id": "handle", "label": "Kollektions-handle", "info": "Bruges kun hvis tema-indstillingen bm_handle_gift_1, _2 eller _3 for denne plads er tom." }
      ]
    }
  ],
  "presets": [
    { "name": "BM gaver efter budget" }
  ]
}
{% endschema %}
