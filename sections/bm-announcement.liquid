{%- capture bm_on -%}{%- render 'bm-active' -%}{%- endcapture -%}
{%- if bm_on == 'true' and settings.bm_announcement_messages != blank -%}
  {%- assign bm_slides = settings.bm_announcement_messages | newline_to_br | split: '<br />' -%}
  <div class="bm-announcement" data-bm-announcement role="region" aria-label="{{ settings.bm_menu_label | escape }}">
    <button type="button" class="bm-announcement__nav" data-bm-ann-prev aria-label="{{ settings.bm_prev_label | escape }}">‹</button>
    <div class="bm-announcement__viewport">
      {%- assign bm_slide_index = 0 -%}
      {%- for bm_slide in bm_slides -%}
        {%- assign bm_slide_text = bm_slide | strip -%}
        {%- if settings.bm_up_to_enabled == false -%}
          {%- assign bm_phrase = settings.bm_up_to_text | replace: '.', '' -%}
          {%- assign bm_slide_text = bm_slide_text | replace: settings.bm_up_to_text, '' | replace: bm_phrase, '' | strip -%}
        {%- endif -%}
        {%- if bm_slide_text != blank -%}
          <p class="bm-announcement__slide{% if bm_slide_index == 0 %} is-active{% endif %}" data-bm-ann-slide>{{ bm_slide_text }}</p>
          {%- assign bm_slide_index = bm_slide_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    <button type="button" class="bm-announcement__nav" data-bm-ann-next aria-label="{{ settings.bm_next_label | escape }}">›</button>
    <button type="button" class="bm-announcement__close" data-bm-ann-close aria-label="{{ settings.bm_close_label | escape }}">×</button>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "BM announcement",
  "settings": [
    {
      "type": "paragraph",
      "content": "Teksten styres af tema-indstillingen Black Month → Announcement. Sektionen vises kun på Black Month-sider."
    }
  ]
}
{% endschema %}
