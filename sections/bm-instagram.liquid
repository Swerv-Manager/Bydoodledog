{%- capture bm_phase_raw -%}{%- render 'bm-phase' -%}{%- endcapture -%}
{%- assign bm_phase_now = bm_phase_raw | strip -%}
{%- if bm_phase_now == 'pre' or bm_phase_now == 'live' -%}
  <section class="bm-section bm-instagram">
    <h2 class="bm-h2 bm-h2--center">{{ settings.bm_ig_title }}</h2>
    {%- assign bm_ig_assets = 'bm-cat-cafe.jpg|bm-cat-taske.jpg' | split: '|' -%}
    <div class="bm-ig__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <a href="{{ section.settings.profile_url | default: 'https://www.instagram.com/bydoodledog/' }}" {{ block.shopify_attributes }}>
            {% render 'bm-media',
              image: block.settings.image,
              asset: bm_ig_assets[forloop.index0],
              alt: settings.bm_ig_title,
              loading: 'lazy',
              width: 600,
              widths: '200, 400, 600',
              sizes: '25vw'
            %}
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for bm_ig_asset in bm_ig_assets -%}
          <a href="{{ section.settings.profile_url | default: 'https://www.instagram.com/bydoodledog/' }}">
            {% render 'bm-media', asset: bm_ig_asset, alt: settings.bm_ig_title, loading: 'lazy', width: 600 %}
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "BM Instagram",
  "settings": [
    {
      "type": "paragraph",
      "content": "Overskrift over det eksisterende Instafeed-app-blok. Statiske billeder er kun fallback, hvis feedet ikke er tilgængeligt."
    },
    { "type": "url", "id": "profile_url", "label": "Profil-link" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Billede",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Billede", "info": "Tom = standardbilledet for denne plads. Instafeed-appen ligger under sektionen." }
      ]
    }
  ],
  "presets": [
    { "name": "BM Instagram" }
  ]
}
{% endschema %}
