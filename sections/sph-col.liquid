<div class="cold24 sph-rel" data-sph-card=""><div class="cold25"><span class="cold26" style="background-image:url('{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 640 }}{%- endif -%}')" role="img" aria-label="{{ product.title | escape }}" role="img" style="background-image:url('{{ 'sph-bjork-kurv-morkbrun-bred_1.jpg' | asset_url }}')"></span><div class="cold27">{%- unless sph_is_lh -%} {%- if sph_bm -%}<span class="cold28"><span class="sc-interp">BLACK MONTH</span></span>{%- endif -%}{%- endunless -%}{%- if sph_is_lh -%}<span class="cold52"><span class="sc-interp">LAGERHYLDEN</span></span>{%- endif -%}{%- if sph_is_new -%}<span class="cold39"><span class="sc-interp">NY</span></span>{%- endif -%}{%- if sph_is_best -%}<span class="cold29"><span class="sc-interp">BESTSELLER</span></span>{%- endif -%}</div></div><div class="cold30">{%- if sph_rc > 0 -%}<div class="cold31"><span class="cold32">★★★★★</span><span class="cold22">{{ sph_rating }}</span></div>{%- endif -%}<div class="cold33">{{ product.title | escape }}</div><div class="cold34"><span class="cold35">{%- if product.price_varies -%}Fra {% endif -%}{{ product.price | money_without_currency }} kr.</span>{%- if sph_has_cmp -%}<span class="cold36">Før {{ product.compare_at_price | money_without_currency }} kr.</span>{%- endif -%}</div>{%- if sph_has_cmp -%}<span class="cold37">Du sparer {{ product.compare_at_price | minus: product.price | money_without_currency }} kr.</span>{%- endif -%}{%- if product.variants.size > 1 or product.available == false -%}<a class="cold38 sph-ovx" href="{{ product.url }}"><span class="sc-interp">Vælg størrelse</span></a>{%- else -%}<form action="/cart/add" method="post" class="sph-form"><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button class="cold54" type="submit"><span class="sc-interp">Læg i kurven</span></button></form>{%- endif -%}</div><a class="sph-cardlink" href="{{ product.url }}" aria-label="{{ product.title | escape }}"></a></div>
