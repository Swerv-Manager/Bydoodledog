{%- liquid
  capture sph_ph
    render 'bm-phase'
  endcapture
  assign sph_ph = sph_ph | strip
  assign sph_bm_on = false
  if sph_ph == 'pre' or sph_ph == 'live'
    assign sph_bm_on = true
  endif
  assign sph_word = 'produkter'
  if collection.handle contains 'kurv'
    assign sph_word = 'kurve'
  endif
  assign sph_sub = 'Minimum 20 % på hele shoppen. Udgåede farver ligger på Lagerhylden – op til 80 %.'
  if collection.handle contains 'kurv'
    assign sph_sub = 'Minimum 20 % på alle kurve. Udgåede farver ligger på Lagerhylden – op til 80 %.'
  endif
  assign sph_chip = collection.current_tags.first | handleize
  assign sph_tile = false
  assign sph_tile_h = 'bjork-hundekurv-mork-brun-i-bred-flojl,by-doodle-dog-skaleunderlag-beige,bali-skalen-mocca,hvalpe-bone-tandplejerne-legetoj' | split: ','
  if all_products[sph_tile_h.first].handle != blank
    assign sph_tile = true
  endif
-%}
{%- paginate collection.products by 14 -%}
{%- liquid
  assign sph_shown = paginate.current_offset | plus: collection.products.size
-%}
<section class="sph sph-col" id="sph-col">
<div class="sph-d">
{%- if sph_bm_on -%}<div class="cold1"><div class="cold2"><span class="cold3"><a href="{{ routes.root_url }}">Forside</a> / {{ collection.title | escape }}</span><span class="cold4">Black Month · 30.10–30.11</span><h1 class="cold5">{{ collection.title | escape }}</h1><p class="cold6">{{ sph_sub }}</p></div><div class="cold7" data-bm-countdown="" data-bm-end="{{ settings.bm_end | escape }}" data-bm-start="{{ settings.bm_start | escape }}" role="timer"><span class="cold4">Black Month slutter om</span><div class="cold8"><div class="cold9"><span class="cold10"><span data-bm-days="">00</span></span><span class="cold11">Dage</span></div><div class="cold9"><span class="cold10"><span data-bm-hours="">00</span></span><span class="cold11">Timer</span></div><div class="cold9"><span class="cold10"><span data-bm-minutes="">00</span></span><span class="cold11">Min</span></div><div class="cold9"><span class="cold12"><span data-bm-seconds="">00</span></span><span class="cold11">Sek</span></div></div><span class="cold13">Mandag 30.11 kl. 23.59</span></div></div>{%- else -%}<div class="sph-plain"><nav class="sph-crumb"><a href="{{ routes.root_url }}">Forside</a> / {{ collection.title | escape }}</nav><h1>{{ collection.title | escape }}</h1></div>{%- endif -%}
<form class="sph-ff" method="get" action="{{ collection.url }}"><input type="hidden" name="view" value="black-month"><div class="cold14"><div class="cold15"><a class="{% if sph_chip == '' %}cold16{% else %}cold17{% endif %}"{% if sph_chip == '' %} aria-current="true"{% endif %} href="{{ collection.url }}?view=black-month"><span class="sc-interp">Alle</span></a><a class="{% if sph_chip == '__none__' %}cold16{% else %}cold17{% endif %}"{% if sph_chip == '__none__' %} aria-current="true"{% endif %} href="{{ collection.url }}?view=black-month"><span class="sc-interp">Black Month</span></a><a class="{% if sph_chip == 'bestseller' %}cold16{% else %}cold17{% endif %}"{% if sph_chip == 'bestseller' %} aria-current="true"{% endif %} href="{{ collection.url }}/bestseller?view=black-month"><span class="sc-interp">Bestsellere</span></a><a class="{% if sph_chip == 'final-sale' %}cold16{% else %}cold17{% endif %}"{% if sph_chip == 'final-sale' %} aria-current="true"{% endif %} href="{{ collection.url }}/final-sale?view=black-month"><span class="sc-interp">Lagerhylden</span></a><a class="{% if sph_chip == 'nyhed' %}cold16{% else %}cold17{% endif %}"{% if sph_chip == 'nyhed' %} aria-current="true"{% endif %} href="{{ collection.url }}/nyhed?view=black-month"><span class="sc-interp">Nyheder</span></a><span class="cold18"></span>{%- if collection.filters != empty -%}{% for f in collection.filters %}<details class="sph-fd"><summary class="cold19">{{ f.label | escape }}{%- if f.active_values.size > 0 %} ({{ f.active_values.size }}){% endif %} <span class="cold20">▾</span></summary><div class="sph-fpanel">{%- case f.type -%}{%- when 'price_range' -%}<label class="sph-fr">Fra <input type="number" min="0" name="{{ f.min_value.param_name }}" value="{% if f.min_value.value %}{{ f.min_value.value | divided_by: 100 }}{% endif %}" placeholder="0" data-sph-money></label><label class="sph-fr">Til <input type="number" min="0" name="{{ f.max_value.param_name }}" value="{% if f.max_value.value %}{{ f.max_value.value | divided_by: 100 }}{% endif %}" placeholder="{{ f.range_max | divided_by: 100 }}" data-sph-money></label>{%- else -%}{% for v in f.values %}<label class="sph-fl"><input type="checkbox" name="{{ v.param_name }}" value="{{ v.value }}"{% if v.active %} checked{% endif %}{% if v.count == 0 and v.active == false %} disabled{% endif %}> <span>{{ v.label | escape }}</span> <small>{{ v.count }}</small></label>{% endfor %}{%- endcase -%}<button type="submit" class="sph-fapply">Vis resultater</button></div></details>{% endfor %}{%- endif -%}</div><div class="cold21"><span class="cold22">{{ sph_shown }} af {{ paginate.items }} {{ sph_word }}</span><label class="cold19 sph-rel"><span>Sortér: {% for o in collection.sort_options %}{% if o.value == collection.sort_by %}{{ o.name | escape }}{% endif %}{% endfor %}{% unless collection.sort_by != blank %}{{ collection.sort_options.first.name | escape }}{% endunless %}</span> <span class="cold20">▾</span><select name="sort_by" class="sph-sortsel" aria-label="Sortér" data-sph-sort>{% for o in collection.sort_options %}<option value="{{ o.value }}"{% if o.value == collection.sort_by %} selected{% endif %}>{{ o.name | escape }}</option>{% endfor %}</select></label></div></div></form>
<div data-sph-grid class="cold23">
{%- for product in collection.products -%}
{%- liquid
  assign sph_bm = false
  if sph_bm_on
    assign sph_bm = true
  endif
  assign sph_is_lh = false
  assign sph_is_new = false
  assign sph_is_best = false
  if product.tags contains 'Final Sale'
    assign sph_is_lh = true
