<div class="cold40"><div class="cold41"><img alt="Hjemmet" class="cold42" decoding="async" loading="lazy" src="{{ 'sph-skaaleunderlag-beige_1.jpg' | asset_url }}"/><span class="cold43">SÆT</span></div><div class="cold44"><span class="cold4">Fuldend kurven</span><div class="cold45">Hjemmet</div><div class="cold13">Bjørk kurv mørk brun S + skåleunderlag + Bali skål + Hvalpe bone</div><div class="cold46"><span class="cold13">Sætpris</span><span class="cold47">Sætpris afventer</span><span class="cold48">Hver for sig {% assign sph_sum = 0 %}{% for h in sph_tile_h %}{% assign sph_sum = sph_sum | plus: all_products[h].price %}{% endfor %}{{ sph_sum | money_without_currency }} kr.</span></div><a class="cold50" href="{{ all_products[sph_tile_h.first].url }}">Se sættet</a><a class="cold51" href="{{ routes.root_url }}#sph-saet">Byg dit eget sæt →</a></div></div>
{%- endif -%}
{%- endfor -%}
