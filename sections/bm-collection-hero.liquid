{%- capture bm_phase_raw -%}{%- render 'bm-phase' -%}{%- endcapture -%}
{%- assign bm_phase_now = bm_phase_raw | strip -%}
{%- if bm_phase_now == 'pre' or bm_phase_now == 'live' -%}
  {%- liquid
    assign bm_sub = settings.bm_collection_sub
    if section.settings.subtitle != blank
      assign bm_sub = section.settings.subtitle
    endif
    if settings.bm_up_to_enabled == false
      assign bm_phrase = settings.bm_up_to_text | replace: '.', ''
      assign bm_sub = bm_sub | replace: settings.bm_up_to_text, '' | replace: bm_phrase, ''
    endif
  -%}
  {%- liquid
    assign bm_col_asset = ''
    if template.suffix == 'black-month-bundles'
      assign bm_col_asset = 'bm-hero-saet.jpg'
    endif
  -%}
  <section class="bm-section bm-col-hero">
    {%- if section.settings.image != blank or bm_col_asset != blank -%}
      <div class="bm-col-hero__media">
        {% render 'bm-media',
          image: section.settings.image,
          asset: bm_col_asset,
          alt: collection.title,
          class: 'bm-col-hero__img',
          loading: 'eager',
          width: 2400,
          height: 944,
          widths: '600, 1200, 1800, 2400',
          sizes: '100vw'
        %}
      </div>
    {%- endif -%}
    <div class="bm-col-hero__copy">
      <p class="bm-eyebrow">{{ settings.bm_hero_eyebrow }}</p>
      <nav class="bm-crumbs" aria-label="breadcrumb">
        <a href="{{ routes.root_url }}">{{ settings.bm_crumb_home }}</a>
        <span aria-hidden="true">/</span>
        {%- capture bm_campaign_url -%}{%- render 'bm-collection-url', handle: settings.bm_handle_campaign -%}{%- endcapture -%}
        {%- assign bm_campaign_url = bm_campaign_url | strip -%}
        {%- if bm_campaign_url == blank -%}
          {%- assign bm_campaign_url = settings.bm_collection_url -%}
        {%- endif -%}
        {%- if bm_campaign_url != blank -%}
          <a href="{{ bm_campaign_url }}">{{ settings.bm_crumb_bm }}</a>
        {%- else -%}
          <span>{{ settings.bm_crumb_bm }}</span>
        {%- endif -%}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ collection.title }}</span>
      </nav>
      <h1 class="bm-col-hero__title">{{ collection.title }}</h1>
      {%- if bm_sub != blank -%}
        <p class="bm-lead">{{ bm_sub }}</p>
      {%- endif -%}
      <p class="bm-col-hero__count">{{ collection.products_count }} {{ settings.bm_products_word }}</p>
    </div>
    <div class="bm-col-hero__aside">
      <p class="bm-hangtag">{{ settings.bm_hangtag }}</p>
      {% render 'bm-countdown' %}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "BM kollektion hero",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Undertekst",
      "info": "Tom = standardteksten. Sæt-siden bruger sin egen undertekst."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero-billede",
      "info": "Tom på sæt-siden = bm-hero-saet.jpg. Andre kollektioner har intet standardbillede."
    }
  ]
}
{% endschema %}
