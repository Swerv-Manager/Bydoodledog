{%- capture bm_phase_raw -%}{%- render 'bm-phase' -%}{%- endcapture -%}
{%- assign bm_phase_now = bm_phase_raw | strip -%}
{%- if bm_phase_now == 'pre' or bm_phase_now == 'live' -%}
  <section class="bm-section bm-bello">
    <div class="bm-section__intro">
      <p class="bm-eyebrow">{{ settings.bm_bello_eyebrow }}</p>
      <h2 class="bm-h2">{{ settings.bm_bello_title }}</h2>
      <p class="bm-lead">{{ settings.bm_bello_text }}</p>
    </div>
    <div class="bm-bello__grid">
      {%- if section.settings.products != blank -%}
        {%- for bm_product in section.settings.products limit: 4 -%}
          <a class="bm-bello__card" href="{{ bm_product.url }}?view=black-month">
            <span class="bm-bello__media">
              {%- assign bm_bello_assets = 'bm-product-bjork-kurv.jpg|bm-product-hjalmar.jpg|bm-product-nora-sele.jpg|bm-product-julius.jpg' | split: '|' -%}
              {%- if bm_product.featured_image -%}
                {{
                  bm_product.featured_image
                  | image_url: width: 800
                  | image_tag: loading: 'eager', widths: '240, 400, 700', sizes: '(min-width: 990px) 22vw, 50vw', alt: bm_product.title, class: 'bm-bello__img'
                }}
              {%- elsif bm_bello_assets[forloop.index0] != blank -%}
                {% render 'bm-media',
                  asset: bm_bello_assets[forloop.index0],
                  alt: bm_product.title,
                  class: 'bm-bello__img',
                  loading: 'eager',
                  width: 800
                %}
              {%- else -%}
                <span class="bm-media-fallback" aria-hidden="true"></span>
              {%- endif -%}
              {% render 'bm-card-badges', product: bm_product, part: 'badges' %}
            </span>
            <span class="bm-bello__price">
              {%- if bm_product.price_varies -%}{{ settings.bm_from_label }} {% endif -%}
              {{ bm_product.price_min | money_without_trailing_zeros }}
            </span>
            {% render 'bm-card-badges', product: bm_product, part: 'save' %}
            <span class="bm-bello__name">{{ bm_product.title }}</span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- assign bm_bello_assets = 'bm-product-bjork-kurv.jpg|bm-product-hjalmar.jpg|bm-product-nora-sele.jpg|bm-product-julius.jpg' | split: '|' -%}
        {%- assign bm_bello_names = settings.bm_bello_names | default: 'Bjørk|Hjalmar|Nora|Julius' | split: '|' -%}
        {%- for bm_bello_asset in bm_bello_assets -%}
          <div class="bm-bello__card">
            <span class="bm-bello__media">
              {% render 'bm-media',
                asset: bm_bello_asset,
                alt: bm_bello_names[forloop.index0],
                class: 'bm-bello__img',
                loading: 'eager',
                width: 800
              %}
            </span>
            <span class="bm-bello__name">{{ bm_bello_names[forloop.index0] }}</span>
          </div>
        {%- endfor -%}
        {%- if request.design_mode -%}
          <p class="bm-editor-note">{{ settings.bm_bello_empty }}</p>
        {%- endif -%}
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "BM Bellos favoritter",
  "settings": [
    {
      "type": "product_list",
      "id": "products",
      "label": "Produkter",
      "limit": 4,
      "info": "Vælg de fire produkter fra mockuppet: Bjørk hundekurv, Hjalmar taske-bilsæde, Nora kropssele, Julius fløjlsslynge."
    }
  ],
  "presets": [
    { "name": "BM Bellos favoritter" }
  ]
}
{% endschema %}
