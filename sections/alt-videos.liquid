<script>
(function(){
  if(window.__bmTileVid)return;window.__bmTileVid=true;
  function init(){
    var vs=[].slice.call(document.querySelectorAll('video[data-bm-tile]'));
    if(!vs.length||window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;
    function start(v){
      if(!v.getAttribute('src')){v.setAttribute('src',v.getAttribute('data-bm-tile'));v.muted=true;v.load();}
      var p=v.play();if(p&&p.catch)p.catch(function(){});
    }
    if(!('IntersectionObserver' in window)){vs.forEach(start);return;}
    var io=new IntersectionObserver(function(es){es.forEach(function(e){
      if(e.isIntersecting)start(e.target);else{try{e.target.pause();}catch(x){}}
    });},{rootMargin:'200px',threshold:0.1});
    vs.forEach(function(v){io.observe(v);});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>
