{%- capture bm_phase_raw -%}{%- render 'bm-phase' -%}{%- endcapture -%}
{%- assign bm_phase_now = bm_phase_raw | strip -%}
{%- if bm_phase_now == 'pre' or bm_phase_now == 'live' -%}
  {%- liquid
    capture bm_campaign_url
      render 'bm-collection-url', handle: settings.bm_handle_campaign
    endcapture
    assign bm_campaign_url = bm_campaign_url | strip
    if bm_campaign_url == blank
      assign bm_campaign_url = settings.bm_collection_url
    endif
    assign bm_primary = settings.bm_cta_primary
    assign bm_primary_url = bm_campaign_url
    if bm_phase_now == 'pre'
      assign bm_primary = settings.bm_signup_cta
      assign bm_primary_url = settings.bm_signup_url
    endif

    assign bm_video_desktop = section.settings.video_desktop
    assign bm_video_mobile = section.settings.video_mobile
    assign bm_url_desktop = section.settings.video_desktop_url | strip
    assign bm_url_mobile = section.settings.video_mobile_url | strip
    assign bm_poster_desktop = section.settings.poster_desktop
    assign bm_poster_mobile = section.settings.poster_mobile
    assign bm_fallback = section.settings.fallback_image

    if bm_fallback != blank
      assign bm_poster_desktop_url = bm_fallback | image_url: width: 1920
      assign bm_poster_mobile_url = bm_fallback | image_url: width: 1200
    else
      if bm_poster_desktop != blank
        assign bm_poster_desktop_url = bm_poster_desktop | image_url: width: 1920
      else
        assign bm_poster_desktop_url = 'bm-hero-16x9-poster.jpg' | asset_url
      endif
      if bm_poster_mobile != blank
        assign bm_poster_mobile_url = bm_poster_mobile | image_url: width: 1200
      else
        assign bm_poster_mobile_url = 'bm-hero-9x16-poster.jpg' | asset_url
      endif
    endif

    assign bm_desktop_src = bm_url_desktop
    if bm_video_desktop != blank and bm_video_desktop.sources.size > 0
      assign bm_picked = ''
      assign bm_mp4 = ''
      for bm_source in bm_video_desktop.sources
        if bm_source.mime_type == 'video/mp4'
          if bm_mp4 == blank
            assign bm_mp4 = bm_source.url
          endif
          if bm_source.url contains '1080'
            assign bm_picked = bm_source.url
          endif
        endif
      endfor
      if bm_picked != blank
        assign bm_desktop_src = bm_picked
      elsif bm_mp4 != blank
        assign bm_desktop_src = bm_mp4
      endif
    endif

    assign bm_mobile_src = bm_url_mobile
    if bm_video_mobile != blank and bm_video_mobile.sources.size > 0
      assign bm_picked = ''
      assign bm_mp4 = ''
      for bm_source in bm_video_mobile.sources
        if bm_source.mime_type == 'video/mp4'
          if bm_mp4 == blank
            assign bm_mp4 = bm_source.url
          endif
          if bm_source.url contains '1080'
            assign bm_picked = bm_source.url
          endif
        endif
      endfor
      if bm_picked != blank
        assign bm_mobile_src = bm_picked
      elsif bm_mp4 != blank
        assign bm_mobile_src = bm_mp4
      endif
    endif
  -%}
  <section class="sph sph-hero" id="bm-hero">
<div class="sph-d"><div class="sd164"><div class="sd165"><div class="sph-hero__media">{%- if bm_fallback != blank -%}{{ bm_fallback | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'sph-hero__poster', alt: 'By Doodle Dog Black Month', widths: '600, 900, 1200, 1600', sizes: '(min-width: 1024px) 50vw, 100vw' }}{%- else -%}<img class="sph-hero__poster" src="{%- if d == 'm' -%}{{ bm_poster_mobile_url }}{%- else -%}{{ bm_poster_desktop_url }}{%- endif -%}" alt="By Doodle Dog Black Month" loading="eager" fetchpriority="high">{%- endif -%}
{%- if bm_desktop_src != blank or bm_mobile_src != blank -%}<video class="sph-hero__video" muted loop playsinline preload="none" poster="{{ bm_poster_desktop_url | escape }}" data-sph-kind="d" data-bm-src-desktop="{{ bm_desktop_src | escape }}" data-bm-src-mobile="{{ bm_mobile_src | escape }}" data-bm-poster-desktop="{{ bm_poster_desktop_url | escape }}" data-bm-poster-mobile="{{ bm_poster_mobile_url | escape }}"></video>{%- endif -%}</div></div><div class="sd166"><div class="sd27"><span class="sd167">Bjørk bilsædet</span><span class="sd28"><span class="sd87">{{ all_products['bjork-bilsaede-til-hunde-beige'].price | money_without_currency }} kr.</span>{% if all_products['bjork-bilsaede-til-hunde-beige'].compare_at_price > all_products['bjork-bilsaede-til-hunde-beige'].price %}<span class="sd168">Før {{ all_products['bjork-bilsaede-til-hunde-beige'].compare_at_price | money_without_currency }} kr.</span>{% endif %}</span></div><a class="sph-ov sd169" href="{{ all_products['bjork-bilsaede-til-hunde-beige'].url }}">Læg i kurven →</a></div><div class="sd170"><div class="sd171"><span class="sd172">20</span><span class="sd173">%</span></div><h1 class="sd174">Minimum 20 % på hele shoppen.</h1><div class="sd175">Sæt, der hører sammen, har deres egen sætpris hele måneden.</div><a class="sph-lnk sd176" href="#sph-saet">Find sæt til din hund ↓</a><div class="sd177">Fri fragt fra 899 kr. · 14 dages returret · Levering på 1–2 dage med GLS · 4,7 på Trustpilot (237 anmeldelser)</div></div><div class="sd178"><div class="sd179"></div><div class="sd180"></div><div class="sd181"><div class="sd182">Åbent</div><div class="sd183">til og med mandag 30.11 kl. 23.59</div></div></div></div></div>
<div class="sph-m"><div class="sm153"><div class="sm154"><div class="sph-hero__media">{%- if bm_fallback != blank -%}{{ bm_fallback | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'sph-hero__poster', alt: 'By Doodle Dog Black Month', widths: '600, 900, 1200, 1600', sizes: '(min-width: 1024px) 50vw, 100vw' }}{%- else -%}<img class="sph-hero__poster" src="{%- if m == 'm' -%}{{ bm_poster_mobile_url }}{%- else -%}{{ bm_poster_desktop_url }}{%- endif -%}" alt="By Doodle Dog Black Month" loading="eager" fetchpriority="high">{%- endif -%}
{%- if bm_desktop_src != blank or bm_mobile_src != blank -%}<video class="sph-hero__video" muted loop playsinline preload="none" poster="{{ bm_poster_desktop_url | escape }}" data-sph-kind="m" data-bm-src-desktop="{{ bm_desktop_src | escape }}" data-bm-src-mobile="{{ bm_mobile_src | escape }}" data-bm-poster-desktop="{{ bm_poster_desktop_url | escape }}" data-bm-poster-mobile="{{ bm_poster_mobile_url | escape }}"></video>{%- endif -%}</div></div><div class="sm155"><div class="sm156"></div><div class="sm157"></div><div class="sm158"><div class="sm159">Åbent</div><div class="sm160">til og med mandag 30.11 kl. 23.59</div></div></div><div class="sm161"><div class="sm162"><span class="sm163">20</span><span class="sm164">%</span></div><h1 class="sm165">Minimum 20 % på hele shoppen.</h1><div class="sm166">Sæt, der hører sammen, har deres egen sætpris hele måneden.</div><a class="sph-lnk sm167" href="#sph-saet">Find sæt til din hund ↓</a><div class="sm168">Fri fragt fra 899 kr. · 14 dages returret · Levering på 1–2 dage med GLS · 4,7 på Trustpilot (237 anmeldelser)</div></div></div></div>
<script>
(function(){
  var sec=document.currentScript&&document.currentScript.closest('.sph-hero');
  if(!sec)return;
  var vids=[].slice.call(sec.querySelectorAll('.sph-hero__video'));
  if(!vids.length)return;
  if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){sec.classList.add('sph-hero--still');return;}
  var mq=window.matchMedia('(max-width: 1023px)');
  function run(){
    vids.forEach(function(v){
      var mob=v.getAttribute('data-sph-kind')==='m';
      var vis=mob===mq.matches;
      if(!vis){try{v.pause();}catch(e){}return;}
      var src=(mob?v.getAttribute('data-bm-src-mobile'):v.getAttribute('data-bm-src-desktop'))||v.getAttribute('data-bm-src-desktop')||v.getAttribute('data-bm-src-mobile')||'';
      var poster=mob?v.getAttribute('data-bm-poster-mobile'):v.getAttribute('data-bm-poster-desktop');
      if(poster)v.poster=poster;
      if(!src)return;
      if(v.getAttribute('src')!==src){v.setAttribute('src',src);v.muted=true;v.load();}
      var p=v.play();if(p&&p.catch)p.catch(function(){});
    });
  }
  run();
  if(mq.addEventListener)mq.addEventListener('change',run);
})();
</script>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "BM hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "Vælg videoen fra Shopify Files. MP4-filen ligger ikke i temaet. Indtil videoen er valgt, vises poster-billedet. URL-feltet er kun et fallback."
    },
    {
      "type": "video",
      "id": "video_desktop",
      "label": "Desktop-video, 16:9",
      "info": "Shopify Files, 16:9. DK-standarden er shopify://files/videos/bm-hero-16x9.mp4. SE lader feltet stå tomt, indtil videoen er valgt. Kun denne fil hentes på skærme over 749px."
    },
    {
      "type": "text",
      "id": "video_desktop_url",
      "label": "Desktop-video URL (fallback)",
      "info": "Én MP4-URL. Bruges kun hvis Shopify-filen ikke er valgt. DK-fallback er 1080p-filen i Shopify Files."
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobil-video, 9:16",
      "info": "Shopify Files, 9:16. DK-standarden er shopify://files/videos/bm-hero-9x16.mp4. Hentes kun under 750px."
    },
    {
      "type": "text",
      "id": "video_mobile_url",
      "label": "Mobil-video URL (fallback)",
      "info": "Bruges kun hvis der ikke er valgt en Shopify-fil."
    },
    {
      "type": "image_picker",
      "id": "poster_desktop",
      "label": "Desktop-poster",
      "info": "Tom = assets/bm-hero-16x9-poster.jpg. Vises før videoen starter, og alene ved reduced motion."
    },
    {
      "type": "image_picker",
      "id": "poster_mobile",
      "label": "Mobil-poster",
      "info": "Tom = assets/bm-hero-9x16-poster.jpg."
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Fallback-billede (valgfrit)",
      "info": "Ikke heroen. Udfyld kun hvis videoen skal erstattes af et stillbillede, fx Speedster-fotoet i assets/bm-hero-speedster.jpg. Tom = poster-billederne."
    },
    {
      "type": "checkbox",
      "id": "show_hangtag",
      "label": "Vis hang-tag",
      "info": "Teksten styres af Black Month → hangtag. Kan slås fra.",
      "default": true
    }
  ],
  "presets": [
    { "name": "BM hero" }
  ]
}
{% endschema %}
