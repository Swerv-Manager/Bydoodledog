{%- capture bm_phase_raw -%}{%- render 'bm-phase' -%}{%- endcapture -%}
{%- assign bm_phase_now = bm_phase_raw | strip -%}
{%- if bm_phase_now == 'pre' or bm_phase_now == 'live' -%}
  {%- liquid
    capture bm_campaign_url
      render 'bm-collection-url', handle: settings.bm_handle_campaign
    endcapture
    assign bm_campaign_url = bm_campaign_url | strip
    if bm_campaign_url == blank
      assign bm_campaign_url = settings.bm_collection_url
    endif
    assign bm_primary = settings.bm_cta_primary
    assign bm_primary_url = bm_campaign_url
    if bm_phase_now == 'pre'
      assign bm_primary = settings.bm_signup_cta
      assign bm_primary_url = settings.bm_signup_url
    endif

    assign bm_video_desktop = section.settings.video_desktop
    assign bm_video_mobile = section.settings.video_mobile
    assign bm_url_desktop = section.settings.video_desktop_url | strip
    assign bm_url_mobile = section.settings.video_mobile_url | strip
    assign bm_poster_desktop = section.settings.poster_desktop
    assign bm_poster_mobile = section.settings.poster_mobile
    assign bm_fallback = section.settings.fallback_image

    if bm_fallback != blank
      assign bm_poster_desktop_url = bm_fallback | image_url: width: 1920
      assign bm_poster_mobile_url = bm_fallback | image_url: width: 1200
    else
      if bm_poster_desktop != blank
        assign bm_poster_desktop_url = bm_poster_desktop | image_url: width: 1920
      else
        assign bm_poster_desktop_url = 'bm-hero-16x9-poster.jpg' | asset_url
      endif
      if bm_poster_mobile != blank
        assign bm_poster_mobile_url = bm_poster_mobile | image_url: width: 1200
      else
        assign bm_poster_mobile_url = 'bm-hero-9x16-poster.jpg' | asset_url
      endif
    endif

    assign bm_desktop_src = bm_url_desktop
    if bm_video_desktop != blank and bm_video_desktop.sources.size > 0
      assign bm_picked = ''
      assign bm_mp4 = ''
      for bm_source in bm_video_desktop.sources
        if bm_source.mime_type == 'video/mp4'
          if bm_mp4 == blank
            assign bm_mp4 = bm_source.url
          endif
          if bm_source.url contains '1080'
            assign bm_picked = bm_source.url
          endif
        endif
      endfor
      if bm_picked != blank
        assign bm_desktop_src = bm_picked
      elsif bm_mp4 != blank
        assign bm_desktop_src = bm_mp4
      endif
    endif

    assign bm_mobile_src = bm_url_mobile
    if bm_video_mobile != blank and bm_video_mobile.sources.size > 0
      assign bm_picked = ''
      assign bm_mp4 = ''
      for bm_source in bm_video_mobile.sources
        if bm_source.mime_type == 'video/mp4'
          if bm_mp4 == blank
            assign bm_mp4 = bm_source.url
          endif
          if bm_source.url contains '1080'
            assign bm_picked = bm_source.url
          endif
        endif
      endfor
      if bm_picked != blank
        assign bm_mobile_src = bm_picked
      elsif bm_mp4 != blank
        assign bm_mobile_src = bm_mp4
      endif
    endif
  -%}
  <section class="alt-sec alt-hero" id="bm-hero"><div class="alt-d"><div class="adhe1"><div class="alt-vid adhe2"><div class="alt-media">{%- if bm_fallback != blank -%}{{ bm_fallback | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'alt-poster', alt: 'By Doodle Dog Black Month', widths: '600, 900, 1200, 1600', sizes: '(min-width: 1024px) 70vw, 100vw' }}{%- else -%}<img class="alt-poster" src="{%- if 'd' == 'm' -%}{{ bm_poster_mobile_url }}{%- else -%}{{ bm_poster_desktop_url }}{%- endif -%}" alt="By Doodle Dog Black Month" loading="eager" fetchpriority="high">{%- endif -%}
{%- if bm_desktop_src != blank or bm_mobile_src != blank -%}<video class="alt-video" muted autoplay loop playsinline webkit-playsinline disablepictureinpicture preload="metadata" poster="{{ bm_poster_desktop_url | escape }}" data-alt-kind="d" data-bm-src-desktop="{{ bm_desktop_src | escape }}" data-bm-src-mobile="{{ bm_mobile_src | escape }}" data-bm-poster-desktop="{{ bm_poster_desktop_url | escape }}" data-bm-poster-mobile="{{ bm_poster_mobile_url | escape }}"></video>{%- endif -%}</div></div><div class="adhe3"></div><div class="adhe4"><span class="adhe5">Black Month · 30.10–30.11</span><h1 class="adhe6">Black<br/>Month<span class="adhe7">.</span></h1><p class="adhe8"><span class="adhe9">Spar op til 80%. </span><span class="adhe10">Minimum 20% på hele shoppen</span></p><div class="adhe11"><a class="scp0 adhe12" href="{{ bm_primary_url }}{% if bm_phase_now == 'live' %}?view=black-month{% endif %}">{% if bm_phase_now == 'pre' %}{{ bm_primary }}{% else %}Se Black Month{% endif %}</a><a class="scp1 adhe13" href="#alt-gifts">Find efter budget</a></div></div><div class="adhe14"><div class="adhe15"><span class="adhe16">Black Month slutter om</span></div><div class="adhe17" data-bm-countdown="" data-bm-end="{{ settings.bm_end | escape }}" data-bm-start="{{ settings.bm_start | escape }}"><div class="adhe18"><span class="adhe19"><span data-bm-days="">07</span></span><span class="adhe5">Dage</span></div><span class="adhe20">:</span><div class="adhe18"><span class="adhe19"><span data-bm-hours="">13</span></span><span class="adhe5">Timer</span></div><span class="adhe20">:</span><div class="adhe18"><span class="adhe19"><span data-bm-minutes="">58</span></span><span class="adhe5">Minuter</span></div><span class="adhe20">:</span><div class="adhe18"><span class="adhe21"><span data-bm-seconds="">54</span></span><span class="adhe5">Sekunder</span></div></div><span class="adhe22">Fri fragt fra 899 kr. · <span class="adhe23">★★★★★</span> 4,8 på Trustpilot</span></div><div class="adhe24"><div class="adhe25"></div><div class="adhe26"></div><div class="adhe27"><div class="adhe28">Black Month</div><div class="adhe29">30.10–30.11</div></div></div></div></div><div class="alt-m"><div class="amhe1"><div class="amhe2"><div class="alt-vid amhe3"><div class="alt-media">{%- if bm_fallback != blank -%}{{ bm_fallback | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'alt-poster', alt: 'By Doodle Dog Black Month', widths: '600, 900, 1200, 1600', sizes: '(min-width: 1024px) 70vw, 100vw' }}{%- else -%}<img class="alt-poster" src="{%- if 'm' == 'm' -%}{{ bm_poster_mobile_url }}{%- else -%}{{ bm_poster_desktop_url }}{%- endif -%}" alt="By Doodle Dog Black Month" loading="eager" fetchpriority="high">{%- endif -%}
{%- if bm_desktop_src != blank or bm_mobile_src != blank -%}<video class="alt-video" muted autoplay loop playsinline webkit-playsinline disablepictureinpicture preload="metadata" poster="{{ bm_poster_desktop_url | escape }}" data-alt-kind="m" data-bm-src-desktop="{{ bm_desktop_src | escape }}" data-bm-src-mobile="{{ bm_mobile_src | escape }}" data-bm-poster-desktop="{{ bm_poster_desktop_url | escape }}" data-bm-poster-mobile="{{ bm_poster_mobile_url | escape }}"></video>{%- endif -%}</div></div><div class="amhe4"></div><div class="amhe5"><span class="amhe6"></span><span class="amhe7"></span><div class="amhe8"><span class="amhe9">Black Month</span><span class="amhe10">30.10–30.11</span></div></div></div><div class="amhe11"><span class="amhe12">Black Month · 30.10–30.11</span><h1 class="amhe13">Black<br/>Month<span class="amhe14">.</span></h1><p class="amhe15"><span class="amhe16">Spar op til 80%.</span><span class="amhe17">Minimum 20% på hele shoppen</span></p><div class="amhe18"><div class="amhe19"><span class="amhe20">Black Month slutter om</span></div><div class="amhe21" data-bm-countdown="" data-bm-end="{{ settings.bm_end | escape }}" data-bm-start="{{ settings.bm_start | escape }}"><div class="amhe22"><span class="amhe23"><span data-bm-days="">07</span></span><span class="amhe12">Dage</span></div><div class="amhe22"><span class="amhe23"><span data-bm-hours="">13</span></span><span class="amhe12">Timer</span></div><div class="amhe22"><span class="amhe23"><span data-bm-minutes="">59</span></span><span class="amhe12">Minuter</span></div><div class="amhe22"><span class="amhe24"><span data-bm-seconds="">00</span></span><span class="amhe12">Sekunder</span></div></div></div><div class="amhe25"><a class="scp0 amhe26" href="{{ bm_primary_url }}{% if bm_phase_now == 'live' %}?view=black-month{% endif %}">{% if bm_phase_now == 'pre' %}{{ bm_primary }}{% else %}Se Black Month{% endif %}</a><a class="scp1 amhe27" href="#alt-gifts">Find efter budget</a></div></div></div></div><script>
(function(){
  var sec=document.currentScript&&document.currentScript.closest('.alt-hero');
  if(!sec)return;
  var vids=[].slice.call(sec.querySelectorAll('.alt-video'));
  if(!vids.length)return;
  /* Reduced-motion bail-out removed: the hero video is muted, loops quietly and must also play on phones with Reduce Motion / battery saver (Frederik 29.10). */
  var mq=window.matchMedia('(max-width: 1023px)');
  function run(){
    vids.forEach(function(v){
      var mob=v.getAttribute('data-alt-kind')==='m';
      if(mob!==mq.matches){try{v.pause();}catch(e){}return;}
      var src=(mob?v.getAttribute('data-bm-src-mobile'):v.getAttribute('data-bm-src-desktop'))||v.getAttribute('data-bm-src-desktop')||v.getAttribute('data-bm-src-mobile')||'';
      var poster=mob?v.getAttribute('data-bm-poster-mobile'):v.getAttribute('data-bm-poster-desktop');
      if(poster)v.poster=poster;
      if(!src)return;
      if(v.getAttribute('src')!==src){v.setAttribute('src',src);v.muted=true;v.load();}
      v.muted=true;v.defaultMuted=true;v.setAttribute('muted','');v.setAttribute('playsinline','');v.setAttribute('webkit-playsinline','');
      var p=v.play();if(p&&p.catch)p.catch(function(){});
    });
  }
  run();
  if(mq.addEventListener)mq.addEventListener('change',run);
  /* Retry play when the browser blocked autoplay (iOS Low Power Mode etc.): on metadata/canplay, on tab visible, and on first touch/scroll. */
  function kick(){vids.forEach(function(v){var mob=v.getAttribute('data-alt-kind')==='m';if(mob!==mq.matches||!v.getAttribute('src'))return;if(v.paused){v.muted=true;var p=v.play();if(p&&p.catch)p.catch(function(){});}});}
  vids.forEach(function(v){v.addEventListener('loadedmetadata',kick);v.addEventListener('canplay',kick);});
  document.addEventListener('visibilitychange',function(){if(!document.hidden)kick();});
  ['touchstart','pointerdown','scroll','click'].forEach(function(ev){window.addEventListener(ev,kick,{once:true,passive:true});});
})();
</script></section>
